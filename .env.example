PORT=3000
# Local default is 127.0.0.1 (this PC only). On a cloud host set HOST=0.0.0.0.
# HOST=127.0.0.1

# Supabase (backend only). Never put these in public/ and never use the secret / service_role key.
# SUPABASE_URL      : https://<project-ref>.supabase.co   (Project URL, not the dashboard page URL)
# SUPABASE_ANON_KEY : the public key (publishable / anon)
SUPABASE_URL=
SUPABASE_ANON_KEY=
